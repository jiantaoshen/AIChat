# Generated build output, local environment files, IDE metadata, dependency
# caches, model assets, private voice data, test artifacts, and runtime data.

# -----------------------------------------------------------------------------
# Frontend / Node.js
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/.nyc_output/
frontend/tsconfig.tsbuildinfo
frontend/.env.local
frontend/.env.*.local

# Keep reproducible dependency metadata tracked.
!frontend/package-lock.json

# -----------------------------------------------------------------------------
# .NET / ASP.NET Core
# -----------------------------------------------------------------------------
backend/bin/
backend/obj/
tests/**/bin/
tests/**/obj/

# Test runner / coverage output.
**/TestResults/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml

# User-specific Visual Studio / MSBuild files.
*.user
*.suo

# -----------------------------------------------------------------------------
# SQLite runtime data
# -----------------------------------------------------------------------------
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.db-journal
backend/data/audio/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# -----------------------------------------------------------------------------
# Local CosyVoice runtime
# -----------------------------------------------------------------------------
# Generated by SETUP_COSYVOICE_WINDOWS.cmd or supplied locally. These files can
# be large, machine-specific, or contain private/reference voice material.
tools/cosyvoice/.venv/
tools/cosyvoice/requirements-windows-venv.txt
tools/cosyvoice/CosyVoice/
tools/cosyvoice/models/
tools/cosyvoice/voice/reference.wav
tools/cosyvoice/voice/reference.txt

# -----------------------------------------------------------------------------
# IDE / OS metadata
# -----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Logs / temporary files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
